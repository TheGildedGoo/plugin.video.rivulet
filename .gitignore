# Python
__pycache__/
*.py[cod]
*.pyz
*.egg-info/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Virtual environments
.venv/
.venv*/
venv/

# Editors / OS
.vscode/
.idea/
.DS_Store

# Packaged addon zips. Local builds stay out of git. The UI fork
# commits one installable zip so it can be installed from zip
# without cutting a release.
/*.zip
/dist/*
!/dist/plugin.video.rivulet-*.zip
/build/

# Generated GitHub Pages repository tree (.github/workflows/repo.yml)
/_repo/
