<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- The Fuse look (lib/ui/fuse.py). Same control ids as the classic file
     of this name, so the same window class drives either; tests/test_fuse.py
     holds that. 1920x1080, standard font names only (font12, font13,
     font45), which Estuary defines. Written by tools/build_fuse_skins.py;
     edit it there. Keep the classic file's
     ids and navigation when editing. -->
<window>
    
    <depth>0.52</depth>
    <coordinates><left>0</left><top>0</top></coordinates>
    <controls>
        <control type="group">
            <left>0</left><top>0</top>
            <visible>!Player.HasVideo</visible>
            <animation type="WindowOpen" reversible="false">
                <effect type="fade" delay="0" end="100" time="200" />
            </animation>
            <!-- No WindowClose animation on purpose: Kodi drops every action while the topmost modal plays one (test_skin_xml.py rule 9). -->
<control type="image" id="30098"><left>0</left><top>0</top><width>1</width><height>1</height><texture background="true"></texture></control><control type="image" id="30099"><left>0</left><top>0</top><width>1</width><height>1</height><texture background="true"></texture></control>
<control type="image"><left>0</left><top>0</top><width>1920</width><height>1080</height><texture colordiffuse="FF000000">white.png</texture></control>
<!-- The backdrop fills the screen; the fades carry the text. -->
<control type="image" id="30000"><left>0</left><top>0</top><width>1920</width><height>1080</height><texture background="true" colordiffuse="FFFFFFFF"></texture><aspectratio align="center" aligny="center">scale</aspectratio><visible>String.IsEmpty(Window.Property(HeroFill))</visible></control>
<control type="image" id="30028"><left>0</left><top>0</top><width>1920</width><height>1080</height><texture background="true" colordiffuse="FFFFFFFF"></texture><aspectratio align="center" aligny="center">scale</aspectratio><visible>!String.IsEmpty(Window.Property(HeroFill))</visible></control>
<!-- No bar: dark toward the left and the bottom, light at the top. -->
<control type="image"><left>0</left><top>0</top><width>1920</width><height>1080</height><texture colordiffuse="FFFFFFFF">fuse_fade_left.png</texture><aspectratio>stretch</aspectratio></control>
<control type="image"><left>0</left><top>0</top><width>1920</width><height>1080</height><texture colordiffuse="FFFFFFFF">fuse_fade_bottom.png</texture><aspectratio>stretch</aspectratio></control>
<control type="image"><left>0</left><top>0</top><width>1920</width><height>220</height><texture colordiffuse="FFFFFFFF">fuse_fade_top.png</texture><aspectratio>stretch</aspectratio></control>
<!-- The classic bar and ratings column: kept for the shared window code, never shown in this look. -->
<control type="image" id="30026"><left>0</left><top>0</top><width>1</width><height>1</height><texture></texture><visible>false</visible></control>
<control type="textbox" id="30021"><left>0</left><top>0</top><width>1</width><height>1</height><font>font12</font><textcolor>FFFFFFFF</textcolor><label>$INFO[ListItem.Property(meta_line)]</label><visible>false</visible></control>
<control type="button" id="30003"><left>0</left><top>0</top><width>1</width><height>1</height><label></label><ondown>30002</ondown><visible>false</visible></control>
<!-- The page's name: REVRIVULET / the catalog (infowindow._header_label). -->
<control type="label" id="30100"><left>80</left><top>36</top><width>940</width><height>50</height><font>font13</font><textcolor>FFEDEDED</textcolor><aligny>center</aligny><label></label></control>
<control type="label"><left>1040</left><top>36</top><width>800</width><height>50</height><font>font13</font><textcolor>FFEDEDED</textcolor><align>right</align><aligny>center</aligny><label>[B]$INFO[System.Time]$INFO[Weather.Temperature,  •  ,][/B]</label></control>
<control type="image" id="30001"><left>810</left><top>200</top><width>300</width><height>10</height><texture colordiffuse="8038BDF8">white.png</texture></control>
<!-- Hero, stacked up from the row by lib/ui/fuse.py: the logo (or the title), stars and facts, the plot (three lines at most), the scores. -->
<control type="image" id="30023"><left>80</left><top>210</top><width>1000</width><height>120</height><aspectratio align="left" aligny="bottom">keep</aspectratio><texture background="true"></texture><visible>!String.IsEmpty(Window.Property(HeroLogo))</visible></control>
<control type="label" id="30020"><left>80</left><top>250</top><width>1100</width><height>80</height><font>font45</font><textcolor>FFEDEDED</textcolor><shadowcolor>C8000000</shadowcolor><aligny>center</aligny><wrapmultiline>false</wrapmultiline><label>[B]$INFO[Container(30002).ListItem.Label][/B]</label><visible>String.IsEmpty(Window.Property(HeroLogo))</visible></control>
<control type="image" id="30027"><left>80</left><top>352</top><width>150</width><height>28</height><aspectratio>keep</aspectratio><texture></texture></control>
<control type="label" id="30024"><left>246</left><top>346</top><width>1200</width><height>40</height><font>font13</font><textcolor>E6EDEDED</textcolor><shadowcolor>C8000000</shadowcolor><aligny>center</aligny><label></label></control>
<control type="textbox" id="30022"><left>80</left><top>396</top><width>920</width><height>110</height><font>font13</font><textcolor>C7EDEDED</textcolor><shadowcolor>C8000000</shadowcolor><autoscroll delay="3000" time="4000" repeat="6000">true</autoscroll><label>$INFO[Container(30002).ListItem.Property(plot)]</label></control>
<control type="label" id="30025"><left>80</left><top>480</top><width>1400</width><height>40</height><font>font13</font><textcolor>E6EDEDED</textcolor><shadowcolor>C8000000</shadowcolor><aligny>center</aligny><label></label></control>
<control type="label"><left>1504</left><top>560</top><width>360</width><height>44</height><font>font12</font><textcolor>B3EDEDED</textcolor><align>right</align><aligny>center</aligny><label>$INFO[Container(30002).CurrentItem] / $INFO[Container(30002).NumItems]</label><visible>Integer.IsGreater(Container(30002).NumItems,0)</visible></control>
<control type="image"><left>80</left><top>610</top><width>1784</width><height>2</height><texture colordiffuse="24EDEDED">white.png</texture></control>
<control type="fixedlist" id="30002">
                <left>64</left><top>560</top><width>1856</width><height>520</height>
                <viewtype>wrap</viewtype><orientation>horizontal</orientation>
                <scrolltime tween="cubic" easing="out">300</scrolltime>
                <focusposition>0</focusposition>
                <onup>30002</onup><ondown>30002</ondown>
                <itemlayout width="232" height="520"><control type="image"><left>16</left><top>72</top><width>200</width><height>300</height><texture colordiffuse="FF16191C">mask_poster.png</texture><visible>String.IsEmpty(ListItem.Property(thumbnail))</visible></control><control type="image"><left>16</left><top>72</top><width>200</width><height>300</height><texture colordiffuse="FF16191C">mask_poster.png</texture><visible>!String.IsEmpty(ListItem.Property(thumbnail))</visible></control><control type="image"><left>16</left><top>72</top><width>200</width><height>300</height><texture diffuse="mask_poster.png" background="true">$INFO[ListItem.Property(thumbnail)]</texture><aspectratio align="center" aligny="center">keep</aspectratio><visible>!String.IsEmpty(ListItem.Property(thumbnail))</visible></control><control type="image"><left>16</left><top>380</top><width>200</width><height>300</height><texture flipy="true" diffuse="mask_poster.png" colordiffuse="66FFFFFF" background="true">$INFO[ListItem.Property(thumbnail)]</texture><aspectratio align="center" aligny="center">keep</aspectratio><visible>!String.IsEmpty(ListItem.Property(thumbnail))</visible></control><control type="image"><left>16</left><top>380</top><width>200</width><height>300</height><texture colordiffuse="FFFFFFFF">fuse_reflect_fade.png</texture><aspectratio>stretch</aspectratio><visible>!String.IsEmpty(ListItem.Property(thumbnail))</visible></control><control type="label"><left>28</left><top>72</top><width>176</width><height>300</height><font>font13</font><textcolor>E6EDEDED</textcolor><align>center</align><aligny>center</aligny><wrapmultiline>true</wrapmultiline><label>$INFO[ListItem.Label]</label><visible>String.IsEmpty(ListItem.Property(thumbnail))</visible></control></itemlayout>
                <focusedlayout width="232" height="520"><control type="image"><left>16</left><top>72</top><width>200</width><height>300</height><texture colordiffuse="FF16191C">mask_poster.png</texture><visible>String.IsEmpty(ListItem.Property(thumbnail))</visible></control><control type="image"><left>16</left><top>72</top><width>200</width><height>300</height><texture colordiffuse="FF16191C">mask_poster.png</texture><visible>!String.IsEmpty(ListItem.Property(thumbnail))</visible></control><control type="image"><left>16</left><top>72</top><width>200</width><height>300</height><texture diffuse="mask_poster.png" background="true">$INFO[ListItem.Property(thumbnail)]</texture><aspectratio align="center" aligny="center">keep</aspectratio><visible>!String.IsEmpty(ListItem.Property(thumbnail))</visible></control><control type="image"><left>16</left><top>380</top><width>200</width><height>300</height><texture flipy="true" diffuse="mask_poster.png" colordiffuse="66FFFFFF" background="true">$INFO[ListItem.Property(thumbnail)]</texture><aspectratio align="center" aligny="center">keep</aspectratio><visible>!String.IsEmpty(ListItem.Property(thumbnail))</visible></control><control type="image"><left>16</left><top>380</top><width>200</width><height>300</height><texture colordiffuse="FFFFFFFF">fuse_reflect_fade.png</texture><aspectratio>stretch</aspectratio><visible>!String.IsEmpty(ListItem.Property(thumbnail))</visible></control><control type="label"><left>28</left><top>72</top><width>176</width><height>300</height><font>font13</font><textcolor>E6EDEDED</textcolor><align>center</align><aligny>center</aligny><wrapmultiline>true</wrapmultiline><label>$INFO[ListItem.Label]</label><visible>String.IsEmpty(ListItem.Property(thumbnail))</visible></control><control type="image"><left>8</left><top>64</top><width>216</width><height>316</height><texture border="24" colordiffuse="FFFFFFFF">fuse_ring.png</texture><visible>Control.HasFocus(30002)</visible></control></focusedlayout>
            </control>
        </control>
    </controls>
</window>
