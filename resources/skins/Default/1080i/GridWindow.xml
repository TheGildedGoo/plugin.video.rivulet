                            <aspectratio align="center" aligny="center">keep</aspectratio>
                            <visible>!String.IsEmpty(ListItem.Property(watched))</visible>
                        </control>
                        <!-- Progress track: 6px over a 59FFFFFF track. At
                             4px/40FFFFFF the whole widget vanished on a real
                             1080p panel, which reads as "no progress" - the
                             one state the bar exists to show. -->
                        <control type="image"><top>294</top><left>16</left><width>200</width><height>6</height><texture colordiffuse="59FFFFFF">white.png</texture>
                            <visible>!String.IsEmpty(ListItem.Property(progress_width))</visible>
                        </control>
                        <control type="image"><top>294</top><left>16</left><height>6</height><texture colordiffuse="FF38BDF8">white.png</texture>
                            <width>$INFO[ListItem.Property(progress_width)]</width>
                            <visible>!String.IsEmpty(ListItem.Property(progress_width))</visible>
                        </control>
                        <control type="label"><top>308</top><left>16</left><width>200</width><height>26</height><font>font10</font><textcolor>A6EEF3F6</textcolor>
                            <label>$INFO[ListItem.Label]</label>
                        </control>
                        <control type="label"><top>336</top><left>16</left><width>200</width><height>22</height><font>font10</font>
                            <label>$INFO[ListItem.Property(badge)]</label>
                        </control>
                    </itemlayout>
                    <focusedlayout width="232" height="364">
                        <control type="group">
                        <!-- Frame behind the poster: 8px of accent shows on the left, right and bottom. The poster covers the top of this plate, so a bar is drawn over the poster's top edge below. -->
                        <control type="image"><top>0</top><left>8</left><width>216</width><height>308</height><texture border="24" colordiffuse="FF38BDF8">round_frame.png</texture></control>
                        <control type="image">
                            <top>0</top><left>16</left><width>200</width><height>300</height>
                            <texture diffuse="mask_poster.png" background="true">$INFO[ListItem.Property(thumbnail)]</texture>
                            <aspectratio align="center" aligny="center">keep</aspectratio>
                        </control>
                        <!-- Accent underline under the focused poster. -->
                        <control type="image"><top>302</top><left>16</left><width>200</width><height>4</height><texture colordiffuse="FF38BDF8">white.png</texture></control>
                        <!-- Progress track: 6px over a 59FFFFFF track. At
                             4px/40FFFFFF the whole widget vanished on a real
                             1080p panel, which reads as "no progress" - the
                             one state the bar exists to show. -->
                        <control type="image"><top>294</top><left>16</left><width>200</width><height>6</height><texture colordiffuse="59FFFFFF">white.png</texture>
                            <visible>!String.IsEmpty(ListItem.Property(progress_width))</visible>
                        </control>
                        <control type="image"><top>294</top><left>16</left><height>6</height><texture colordiffuse="FF38BDF8">white.png</texture>
                            <width>$INFO[ListItem.Property(progress_width)]</width>
                            <visible>!String.IsEmpty(ListItem.Property(progress_width))</visible>
                        </control>
                        <control type="label"><top>308</top><left>16</left><width>200</width><height>26</height><font>font10</font><textcolor>FFFFFFFF</textcolor>
                            <label>[B]$INFO[ListItem.Label][/B]</label>
                        </control>
                        <control type="label"><top>336</top><left>16</left><width>200</width><height>22</height><font>font10</font>
                            <label>$INFO[ListItem.Property(badge)]</label>
                        </control>
                        </control>
                    </focusedlayout>
                </control></control>
            </control>
        </control>
    </controls>
</window>
