<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<window>
    <!-- Rev2Rivulet. Art masks are full-opacity rounded rectangles
         at the control size: no grey plate, no border on the diffuse. -->

    <defaultcontrol always="true">30011</defaultcontrol>
    <depth>0.52</depth>
    <coordinates><left>0</left><top>0</top></coordinates>
    <controls>
        <control type="group">
            <left>0</left><top>0</top>
            <visible>!Player.HasVideo</visible>
            <animation type="WindowOpen" reversible="false">
                <effect type="fade" delay="0" end="100" time="200" />
            </animation>
            <!-- No WindowClose animation on purpose: Kodi drops every action while the topmost modal plays one (test_skin_xml.py rule 9). -->
            <control type="image"><width>1920</width><height>1080</height><texture colordiffuse="FF0A0D12">white.png</texture></control>
            <control type="image" id="30000"><width>1920</width><height>1080</height><texture background="true" colordiffuse="FFFFFFFF"></texture><aspectratio>scale</aspectratio></control>
            <control type="image"><width>1280</width><height>1080</height><texture colordiffuse="E60A0D12">fade_h.png</texture></control>
            <!-- fade_v.png is opaque only from about 75% of its height.
                 280 + 0.75*496 = 652, the top of the row band. The solid
                 plate under it is what keeps the art off the rows. -->
            <control type="image"><left>0</left><top>280</top><width>1920</width><height>496</height><texture colordiffuse="FF0A0D12">fade_v.png</texture></control>
            <control type="image"><left>0</left><top>652</top><width>1920</width><height>428</height><texture colordiffuse="FF0A0D12">white.png</texture></control>

            <control type="image"><left>64</left><top>22</top><width>48</width><height>48</height><texture>logo.png</texture><aspectratio>keep</aspectratio></control>
            <control type="label"><left>124</left><top>16</top><width>360</width><height>52</height><font>font37</font><textcolor>FFEEF3F6</textcolor><aligny>center</aligny><label>[B]$ADDON[plugin.video.revrivulet 30432][/B]</label></control>
            <control type="label" id="30005">
                <left>64</left><top>68</top><width>760</width><height>28</height><font>font12</font><textcolor>C8EEF3F6</textcolor><aligny>center</aligny>
                <label></label>
            </control>
            <control type="grouplist" id="30011">
                <left>640</left><top>16</top><width>1216</width><height>64</height>
                <orientation>horizontal</orientation>
                <align>right</align>
                <itemgap>12</itemgap>
                <onleft>30011</onleft><onright>30011</onright>
                <onup>30011</onup><ondown>31000</ondown>
                <scrolltime tween="cubic" easing="out">180</scrolltime>
<control type="button" id="30073"><width>210</width><height>56</height><font>font13</font><textcolor>99EEF3F6</textcolor><focusedcolor>FF0A0D12</focusedcolor><align>center</align><aligny>center</aligny><texturefocus border="28" colordiffuse="FFFFFFFF">pill_fill.png</texturefocus><texturenofocus border="28" colordiffuse="14FFFFFF">pill_fill.png</texturenofocus><label>$ADDON[plugin.video.revrivulet 30427]</label><ondown>31000</ondown><onup>30011</onup><visible>!String.IsEmpty(Window.Property(HomeSignedOut))</visible></control><control type="button" id="30070"><width>210</width><height>56</height><font>font13</font><textcolor>99EEF3F6</textcolor><focusedcolor>FF0A0D12</focusedcolor><align>center</align><aligny>center</aligny><texturefocus border="28" colordiffuse="FFFFFFFF">pill_fill.png</texturefocus><texturenofocus border="28" colordiffuse="14FFFFFF">pill_fill.png</texturenofocus><label>$ADDON[plugin.video.revrivulet 30001]</label><ondown>31000</ondown><onup>30011</onup></control><control type="button" id="30071"><width>210</width><height>56</height><font>font13</font><textcolor>99EEF3F6</textcolor><focusedcolor>FF0A0D12</focusedcolor><align>center</align><aligny>center</aligny><texturefocus border="28" colordiffuse="FFFFFFFF">pill_fill.png</texturefocus><texturenofocus border="28" colordiffuse="14FFFFFF">pill_fill.png</texturenofocus><label>$ADDON[plugin.video.revrivulet 30003]</label><ondown>31000</ondown><onup>30011</onup></control><control type="button" id="30072"><width>210</width><height>56</height><font>font13</font><textcolor>99EEF3F6</textcolor><focusedcolor>FF0A0D12</focusedcolor><align>center</align><aligny>center</aligny><texturefocus border="28" colordiffuse="FFFFFFFF">pill_fill.png</texturefocus><texturenofocus border="28" colordiffuse="14FFFFFF">pill_fill.png</texturenofocus><label>$ADDON[plugin.video.revrivulet 30004]</label><ondown>31000</ondown><onup>30011</onup></control>
            </control>

            <!-- Hero, upper left, over the full-screen fanart. The title
                 and the clearlogo share one 64px band. font37 is 37, so
                 that band is the max height. The metadata line is next.
                 The description is two lines of font13 (30) and scrolls
                 inside the box. It ends at y=348, above the row band.
                 background=true: Kodi otherwise paints a grey box while
                 the clearlogo loads, and again when the file is missing. -->
            <control type="image" id="30023">
                <left>64</left><top>172</top><width>780</width><height>64</height>
                <aspectratio align="left" aligny="center">keep</aspectratio>
                <texture background="true"></texture>
                <visible>!String.IsEmpty(Window.Property(HeroLogo))</visible>
            </control>
            <control type="label" id="30020">
                <left>64</left><top>172</top><width>900</width><height>64</height>
                <font>font37</font><textcolor>FFFFFFFF</textcolor><aligny>center</aligny>
                <wrapmultiline>false</wrapmultiline>
                <label></label>
                <visible>String.IsEmpty(Window.Property(HeroLogo))</visible>
            </control>
            <control type="label" id="30021">
                <left>64</left><top>244</top><width>980</width><height>32</height>
                <font>font12</font><textcolor>C8EEF3F6</textcolor><aligny>center</aligny>
                <label></label>
            </control>
            <control type="textbox" id="30022">
                <left>64</left><top>284</top><width>820</width><height>64</height>
                <font>font13</font><textcolor>B3EEF3F6</textcolor>
                <autoscroll delay="2000" time="4000" repeat="6000">true</autoscroll>
                <label></label>
            </control>

            <!-- One list item per catalog. Kodi draws only the visible rows; Python fills posters as the remote moves. -->
            <control type="fixedlist" id="31000">
                <left>48</left><top>652</top><width>1840</width><height>428</height>
                <orientation>vertical</orientation>
                <!-- focusposition 0 pins the focused catalog at the top of
                     this band. The height is one 340px row plus a peek of
                     the next, so moving down scrolls rows up into the band. -->
                <focusposition>0</focusposition>
                <onleft>31000</onleft><onright>31000</onright>
                <onup>30011</onup><ondown>31000</ondown>
                <scrolltime tween="cubic" easing="out">280</scrolltime>
                <itemlayout height="340">
