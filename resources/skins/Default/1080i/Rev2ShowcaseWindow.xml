<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<window>
    <!-- Rev2Rivulet. Art masks are full-opacity rounded rectangles
         at the control size: no grey plate, no border on the diffuse. -->

    <depth>0.52</depth>
    <coordinates><left>0</left><top>0</top></coordinates>
    <controls>
        <control type="group">
            <left>0</left><top>0</top>
            <visible>!Player.HasVideo</visible>
            <animation type="WindowOpen" reversible="false">
                <effect type="slide" start="0,100" end="0,0" delay="160" time="160" />
                <effect type="fade" delay="160" end="100" time="100" />
            </animation>
            <!-- No WindowClose animation on purpose: Kodi drops every action while the topmost modal plays one (test_skin_xml.py rule 9). -->
            <!-- Fallback wash: covers the instant this window opens, before
                 the background image below has a texture to draw - keeps
                 the opening frame dark instead of flashing skin-default
                 white. -->
            <control type="image"><width>1920</width><height>1080</height><texture colordiffuse="E60A0C0E">white.png</texture></control>
            <!-- Shown whole. scale cropped it, and the old FF8C8C8C
                 multiply dimmed it to 55%. The plate behind is already
                 dark, so a non-16:9 backdrop letterboxes. -->
            <control type="image" id="30000"><width>1920</width><height>1080</height><texture background="true" colordiffuse="FFFFFFFF"></texture><aspectratio align="center" aligny="center">keep</aspectratio></control>
            <!-- fade_h.png is a light vignette: clear on the left, only
                 partly dark on the right, the same on every row. The
                 ratings sit on the scrim, not in a black rectangle. -->
            <control type="image"><left>1440</left><top>0</top><width>480</width><height>1080</height><aspectratio>stretch</aspectratio><texture colordiffuse="E60A0D12">fade_h.png</texture></control>
            <!-- fade_v.png stays clear through the hero text and is
                 opaque from about 75% of its height. It starts at y=0
                 so there is no step under the header. 0.75*987 = 740,
                 the row. A ramp that was already dark behind the title
                 read as a hard-edged block. The plate keeps the art
                 off the row. -->
            <control type="image"><left>0</left><top>0</top><width>1920</width><height>987</height><aspectratio>stretch</aspectratio><texture colordiffuse="FF0A0D12">fade_v.png</texture></control>
            <control type="image"><left>0</left><top>740</top><width>1920</width><height>340</height><texture colordiffuse="FF0A0D12">white.png</texture></control>
            <control type="image" id="30001"><top>200</top><left>810</left><width>300</width><height>10</height><texture>white.png</texture>
                <animation effect="zoom" pulse="true" center="auto" start="0,100" end="100,100" time="1000" condition="Control.IsVisible(30001)">Conditional</animation>
            </control>

            <!-- Header: wordmark, breadcrumb, position counter, close. -->
            <control type="image"><left>96</left><top>60</top><width>36</width><height>36</height><texture>logo.png</texture><aspectratio>keep</aspectratio></control>
            <!-- Breadcrumb: ShowcaseWindow.py's onInit() sets this label's
                 text via setLabel() (not an $INFO[] binding - the title is
                 built with inline [COLOR] markup, not a single ListItem/
                 Window property) to "$ADDON[plugin.video.revrivulet 30432]" alone, or "$ADDON[plugin.video.revrivulet 30432] /
                 <CATALOG>" once open_showcase() is handed a catalog_title -
                 see infowindow.py's `_header_label()`. -->
            <control type="label" id="30100"><left>144</left><top>60</top><width>760</width><height>36</height><font>font10</font><aligny>center</aligny>
                <label>[COLOR 57EEF3F6]$ADDON[plugin.video.revrivulet 30432][/COLOR]</label>
            </control>
            <control type="label"><right>190</right><top>60</top><width>140</width><height>36</height><font>Mono26</font><align>right</align><aligny>center</aligny>
                <label>[COLOR 80EEF3F6]$INFO[Container(30002).CurrentItem][/COLOR][COLOR 47EEF3F6]/$INFO[Container(30002).NumItems][/COLOR]</label>
            </control>
            <control type="button" id="30003">
                <left>1774</left><top>53</top><width>50</width><height>50</height><aligny>center</aligny><align>center</align>
                <texturefocus colordiffuse="FFFFFFFF">close.png</texturefocus>
                <texturenofocus colordiffuse="73FFFFFF">close.png</texturenofocus>
                <ondown>30002</ondown>
            </control>

            <!-- Title on the left, just above the row. font60 is 60, and
                 its line box is taller than the point size, so the
                 control is 92. The description is the next control,
                 directly under it: six lines of font27 (27) inside 55%
                 of the screen (1056px), ending on the row at y=740.
                 Each block sits on a scrim that fades out at the edges;
                 Python sizes it to the text. -->
            <!-- scrim_feather.png is clear at the rim (border 40) and
                 dark in the middle. These boxes are the largest the text
                 gets; lib/ui/heroscrim.py pulls them in to the words. -->
            <control type="image" id="30026">
                <left>56</left><top>420</top><width>1136</width><height>360</height>
                <aspectratio>stretch</aspectratio>
                <texture border="40" colordiffuse="FF0A0D12">scrim_feather.png</texture>
            </control>
            <control type="image" id="30027">
                <left>1440</left><top>420</top><width>460</width><height>360</height>
                <aspectratio>stretch</aspectratio>
                <texture border="40" colordiffuse="FF0A0D12">scrim_feather.png</texture>
            </control>
            <control type="label"><left>96</left><top>460</top><width>1056</width><height>92</height><font>font60</font><textcolor>FFFFFFFF</textcolor><shadowcolor>C8000000</shadowcolor><aligny>center</aligny>
                <wrapmultiline>false</wrapmultiline>
                <label>[B]$INFO[ListItem.Label][/B]</label>
            </control>

            <!-- Six lines of font27 (27). The rest scrolls. It starts
                 under the title, not under the ratings, and ends on
                 the row at y=740. 180px leaves a little slack so Kodi's
                 textbox inset does not clip the first or last line. -->
            <control type="textbox"><left>96</left><top>560</top><width>1056</width><height>180</height><font>font27</font><textcolor>F2EEF3F6</textcolor><shadowcolor>C8000000</shadowcolor>
                <label>$INFO[ListItem.Property(plot)]</label>
                <autoscroll time="3000" delay="3000" repeat="3000">true</autoscroll>
            </control>

            <!-- Ratings in the right quarter, level with the title.
                 One textbox, because the old chips were fixed 110px
                 boxes and a series range rendered as "2010...".
                 infowindow builds meta_line with one fact per line and
                 skips whatever the meta lacks, so a missing Rotten
                 Tomatoes score is absent rather than blank. font12
                 (NotoSans): the panel names IMDb, and NotoMono has no
                 star glyph. -->
            <control type="textbox"><left>1480</left><top>460</top><width>380</width><height>280</height><font>font12</font><textcolor>FFFFFFFF</textcolor><align>right</align>
                <label>$INFO[ListItem.Property(meta_line)]</label>
                <visible>!String.IsEmpty(ListItem.Property(meta_line))</visible>
            </control>

            <!-- One row of 220px cells (200px poster). The list is exactly
                 that row tall, so a second row cannot show. Up and down
                 are handled in Python: they move eight titles, one
                 viewport, and the hero follows the focused item. -->
            <control type="fixedlist" id="30002">
                <top>740</top><left>48</left><width>1840</width><height>340</height>
                <viewtype>wrap</viewtype><orientation>horizontal</orientation>
                <scrolltime tween="cubic" easing="out">300</scrolltime>
                <focusposition>0</focusposition>
                <onup>30002</onup><ondown>30002</ondown>
                <itemlayout width="220" height="340">
                    <control type="image">
                        <top>20</top><left>10</left><width>200</width><height>300</height>
                        <texture diffuse="rv_mask_200x300.png" background="true">$INFO[ListItem.Property(thumbnail)]</texture>
                        <aspectratio align="center" aligny="center">keep</aspectratio>
                    </control>
                </itemlayout>
                <focusedlayout width="220" height="340">
                    <control type="image">
                        <top>20</top><left>10</left><width>200</width><height>300</height>
                        <texture diffuse="rv_mask_200x300.png" background="true">$INFO[ListItem.Property(thumbnail)]</texture>
                        <aspectratio align="center" aligny="center">keep</aspectratio>
                    </control>
                    <control type="image"><top>20</top><left>10</left><width>200</width><height>300</height><texture border="16" colordiffuse="FFFFFFFF">focus_stroke.png</texture></control>
                </focusedlayout>
            </control>
        </control>
    </controls>
</window>
