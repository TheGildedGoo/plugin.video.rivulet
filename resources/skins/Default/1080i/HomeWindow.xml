<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<window>
    <!-- The rows, not the top bar, and not always="true": Kodi then
         restores the control the remote was on when this dialog reopens
         after playback, instead of flashing the Search pill first. -->
    <defaultcontrol>30001</defaultcontrol>
    <depth>0.52</depth>
    <coordinates><left>0</left><top>0</top></coordinates>
    <controls>
        <control type="group">
            <left>0</left><top>0</top>
            <visible>!Player.HasVideo</visible>
            <animation type="WindowOpen" reversible="false">
                <effect type="fade" delay="0" end="100" time="200" />
            </animation>
            <!-- No WindowClose animation on purpose: Kodi drops every action while the topmost modal plays one (test_skin_xml.py rule 9). -->
            <control type="image"><width>1920</width><height>1080</height><texture colordiffuse="FF07090B">white.png</texture></control>
            <!-- Poster warm slots (lib/ui/posterwarm.py). Visible and under the
                 backdrop: Kodi only fetches a texture for a control it draws, and
                 a separate window cannot open while this dialog is up. -->
            <control type="image" id="30090"><left>0</left><top>0</top><width>1</width><height>1</height><texture background="true"></texture></control><control type="image" id="30091"><left>0</left><top>0</top><width>1</width><height>1</height><texture background="true"></texture></control><control type="image" id="30092"><left>0</left><top>0</top><width>1</width><height>1</height><texture background="true"></texture></control><control type="image" id="30093"><left>0</left><top>0</top><width>1</width><height>1</height><texture background="true"></texture></control><control type="image" id="30094"><left>0</left><top>0</top><width>1</width><height>1</height><texture background="true"></texture></control><control type="image" id="30095"><left>0</left><top>0</top><width>1</width><height>1</height><texture background="true"></texture></control><control type="image" id="30096"><left>0</left><top>0</top><width>1</width><height>1</height><texture background="true"></texture></control><control type="image" id="30097"><left>0</left><top>0</top><width>1</width><height>1</height><texture background="true"></texture></control>
            <!-- keep, not scale: scale fills the frame and crops the
                 picture. The plate behind this image is already black, so
                 a backdrop that is not 16:9 letterboxes instead. -->
            <control type="image" id="30000"><width>1920</width><height>1080</height><texture background="true" colordiffuse="FFFFFFFF"></texture><aspectratio align="center" aligny="center">keep</aspectratio><visible>String.IsEmpty(Window.Property(HeroFill))</visible></control>
            <!-- scale, not keep: a library poster has no backdrop yet.
                 keep letterboxes it. This plate covers the frame until
                 Cinemeta supplies a real background. -->
            <control type="image" id="30028"><width>1920</width><height>1080</height><texture background="true" colordiffuse="FFFFFFFF"></texture><aspectratio align="center" aligny="center">scale</aspectratio><visible>!String.IsEmpty(Window.Property(HeroFill))</visible></control>
            <!-- fade_h.png is a light vignette: clear on the left, only
                 partly dark on the right, the same on every row. The
                 ratings sit on the bar at the bottom of the picture. -->
            <control type="image"><left>1440</left><top>0</top><width>480</width><height>1080</height><aspectratio>stretch</aspectratio><texture colordiffuse="E607090B">fade_h.png</texture></control>
            <!-- fade_v.png stays clear through the hero text and is
                 opaque from about 75% of its height. It starts at y=0
                 so there is no step under the header. 0.75*923 = 692,
                 the row. A ramp that was already dark behind the title
                 read as a hard-edged block. The plate keeps the art
                 off the row. -->
            <control type="image"><left>0</left><top>0</top><width>1920</width><height>923</height><aspectratio>stretch</aspectratio><texture colordiffuse="FF07090B">fade_v.png</texture></control>
            <control type="image"><left>0</left><top>692</top><width>1920</width><height>388</height><texture colordiffuse="FF07090B">white.png</texture></control>

            <control type="image"><left>64</left><top>42</top><width>48</width><height>48</height><texture>logo.png</texture><aspectratio>keep</aspectratio></control>
            <control type="label"><left>124</left><top>36</top><width>360</width><height>52</height><font>font37</font><textcolor>FFEEF3F6</textcolor><aligny>center</aligny><label>[B]RevRivulet[/B]</label></control>
            <control type="label" id="30005">
                <left>64</left><top>86</top><width>760</width><height>28</height><font>font12</font><textcolor>C8EEF3F6</textcolor><aligny>center</aligny>
                <label></label>
            </control>
            <!-- One focusable header row (#23): the type pills on the left,
                 Sign in (signed out only), Search, Add-ons and Settings on the
                 right, level with them. Left from the first tool crosses to the
                 pills, Right from the last pill crosses here; Settings stays the
                 rightmost and Right stops on it. The wordmark line above is not
                 focusable. Both sit 36px or more off the top edge (#7).
                 pill_fill.png is a 9-slice capsule. -->
            <control type="grouplist" id="30011">
                <left>960</left><top>128</top><width>896</width><height>56</height>
                <orientation>horizontal</orientation>
                <align>right</align>
                <itemgap>12</itemgap>
                <onleft>30010</onleft><onright>30072</onright>
                <onup>30011</onup><ondown>30001</ondown>
                <scrolltime tween="cubic" easing="out">180</scrolltime>
<control type="button" id="30073"><width>210</width><height>56</height><font>font13</font><textcolor>99EEF3F6</textcolor><focusedcolor>FF07090B</focusedcolor><align>center</align><aligny>center</aligny><texturefocus border="28" colordiffuse="FFFFFFFF">pill_fill.png</texturefocus><texturenofocus border="28" colordiffuse="14FFFFFF">pill_fill.png</texturenofocus><label>$ADDON[plugin.video.revrivulet 30427]</label><ondown>30001</ondown><onup>30011</onup><visible>!String.IsEmpty(Window.Property(HomeSignedOut))</visible></control><control type="button" id="30070"><width>210</width><height>56</height><font>font13</font><textcolor>99EEF3F6</textcolor><focusedcolor>FF07090B</focusedcolor><align>center</align><aligny>center</aligny><texturefocus border="28" colordiffuse="FFFFFFFF">pill_fill.png</texturefocus><texturenofocus border="28" colordiffuse="14FFFFFF">pill_fill.png</texturenofocus><label>$ADDON[plugin.video.revrivulet 30001]</label><ondown>30001</ondown><onup>30011</onup></control><control type="button" id="30071"><width>210</width><height>56</height><font>font13</font><textcolor>99EEF3F6</textcolor><focusedcolor>FF07090B</focusedcolor><align>center</align><aligny>center</aligny><texturefocus border="28" colordiffuse="FFFFFFFF">pill_fill.png</texturefocus><texturenofocus border="28" colordiffuse="14FFFFFF">pill_fill.png</texturenofocus><label>$ADDON[plugin.video.revrivulet 30003]</label><ondown>30001</ondown><onup>30011</onup></control><control type="button" id="30072"><width>210</width><height>56</height><font>font13</font><textcolor>99EEF3F6</textcolor><focusedcolor>FF07090B</focusedcolor><align>center</align><aligny>center</aligny><texturefocus border="28" colordiffuse="FFFFFFFF">pill_fill.png</texturefocus><texturenofocus border="28" colordiffuse="14FFFFFF">pill_fill.png</texturenofocus><label>$ADDON[plugin.video.revrivulet 30004]</label><ondown>30001</ondown><onup>30011</onup></control>
            </control>

            <!-- Type pills: the left half of the header row, not inside the
                 scrolling rows. 900px holds all four. Up has nowhere to go;
                 with no pills, Python sends Up from the first row to the tools. -->
            <control type="list" id="30010">
                <left>48</left><top>124</top><width>900</width><height>64</height>
                <orientation>horizontal</orientation>
                <onleft>30010</onleft><onright>30011</onright>
                <onup>30010</onup><ondown>30001</ondown>
                <scrolltime tween="cubic" easing="out">180</scrolltime>
                <visible>!String.IsEmpty(Window.Property(HomeBrowse))</visible>
                <itemlayout width="220" height="64">
                    <control type="image"><left>8</left><top>4</top><width>204</width><height>56</height><texture border="28" colordiffuse="14FFFFFF">pill_fill.png</texture></control>
                    <control type="label"><left>8</left><top>4</top><width>204</width><height>56</height><font>font13</font><textcolor>99EEF3F6</textcolor><align>center</align><aligny>center</aligny>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                </itemlayout>
                <!-- Kodi draws focusedlayout on the selected pill whether or not
                     the list has the remote. On a shared header row a white pill
                     here beside a focused tool read as two places at once, so the
                     filled pill is gated to real focus. -->
                <focusedlayout width="220" height="64">
                    <control type="image"><left>8</left><top>4</top><width>204</width><height>56</height><texture border="28" colordiffuse="FFFFFFFF">pill_fill.png</texture><visible>Control.HasFocus(30010)</visible></control>
                    <control type="label"><left>8</left><top>4</top><width>204</width><height>56</height><font>font13</font><textcolor>FF07090B</textcolor><align>center</align><aligny>center</aligny>
                        <label>[B]$INFO[ListItem.Label][/B]</label>
                        <visible>Control.HasFocus(30010)</visible>
                    </control>
                    <control type="image"><left>8</left><top>4</top><width>204</width><height>56</height><texture border="28" colordiffuse="14FFFFFF">pill_fill.png</texture><visible>!Control.HasFocus(30010)</visible></control>
                    <control type="label"><left>8</left><top>4</top><width>204</width><height>56</height><font>font13</font><textcolor>99EEF3F6</textcolor><align>center</align><aligny>center</aligny>
                        <label>$INFO[ListItem.Label]</label>
                        <visible>!Control.HasFocus(30010)</visible>
                    </control>
                </focusedlayout>
            </control>

            <!-- Hero. Title and clearlogo share one 64px band (font37 is
                 37). The description is the next control, directly under
                 the title: six lines of font13 (30) in a 200px box, 55%
                 of the screen (1056px), so a plot wraps instead of
                 clipping off the right edge. The stack ends 40px above
                 the row (y=652) so the row title is not tight against
                 the description. Ratings are the textbox in the right quarter,
                 level with that stack. Both sit on one black bar across
                 the screen. Its top fades into the picture; Python
                 shortens it when the text is short.
                 A fact the meta does not carry is omitted. background=true:
                 Kodi otherwise paints a grey box while the clearlogo loads.
                 The shadow keeps the title readable on a bright backdrop. -->
            <control type="image" id="30026">
                <left>0</left><top>316</top><width>1920</width><height>336</height>
                <aspectratio>stretch</aspectratio>
                <texture border="0,64,0,8" colordiffuse="FF07090B">hero_bar.png</texture>
            </control>
            <control type="image" id="30023">
                <left>64</left><top>380</top><width>1056</width><height>64</height>
                <aspectratio align="left" aligny="center">keep</aspectratio>
                <texture background="true"></texture>
                <visible>!String.IsEmpty(Window.Property(HeroLogo))</visible>
            </control>
            <control type="label" id="30020">
                <left>64</left><top>380</top><width>1056</width><height>64</height>
                <font>font37</font><textcolor>FFFFFFFF</textcolor><shadowcolor>C8000000</shadowcolor><aligny>center</aligny>
                <wrapmultiline>false</wrapmultiline>
                <label></label>
                <visible>String.IsEmpty(Window.Property(HeroLogo))</visible>
            </control>
            <control type="textbox" id="30022">
                <left>64</left><top>452</top><width>1056</width><height>200</height>
                <font>font13</font><textcolor>F2EEF3F6</textcolor><shadowcolor>C8000000</shadowcolor>
                <autoscroll delay="2000" time="4000" repeat="6000">true</autoscroll>
                <label></label>
            </control>
            <control type="textbox" id="30021">
                <left>1480</left><top>380</top><width>380</width><height>272</height>
                <font>font12</font><textcolor>FFFFFFFF</textcolor><align>right</align>
                <label></label>
            </control>

            <!-- Each shelf is a 388px group, the same height as this
                 viewport, so up and down leave the focused row in place
                 and only that row is on screen. itemgap is 0: a negative
                 gap would pull the next heading into the band. The panels
                 set onup/ondown themselves: a grouplist only wires that
                 chain onto its direct children. -->
            <control type="grouplist" id="30001">
                <left>48</left><top>692</top><width>1840</width><height>388</height>
                <orientation>vertical</orientation>
                <itemgap>0</itemgap>
                <onup>30010</onup><ondown>30001</ondown>
                <onleft>30001</onleft><onright>30001</onright>
                <usecontrolcoords>true</usecontrolcoords>
                <scrolltime tween="cubic" easing="out">280</scrolltime>
